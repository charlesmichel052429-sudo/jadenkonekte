# Service assistant agronome (RAG) : même code que le backend + fastembed + SDK Anthropic.
# Le modèle d'embeddings est téléchargé à la construction de l'image : le service démarre hors ligne.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 EMBEDDINGS_CACHE=/app/modeles
WORKDIR /app
COPY backend/requirements.txt backend/requirements-assistant.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-assistant.txt
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2', cache_dir='/app/modeles')" \
 && chown -R 1000:1000 /app/modeles
COPY backend/jaden /app/jaden
USER 1000
CMD ["uvicorn", "jaden.assistant.service:app", "--host", "0.0.0.0", "--port", "8000"]
