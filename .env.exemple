# Modèle du fichier .env (exclu de Git). Génération : .\scripts\initialiser-env.ps1

# Base de données
POSTGRES_USER=jaden
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=jaden

# Comptes MQTT
MQTT_APP_MOT_DE_PASSE=a-remplacer
MQTT_SIMULATEUR_MOT_DE_PASSE=a-remplacer

# API
JWT_SECRET=a-remplacer-par-au-moins-32-caracteres-aleatoires
ADMIN_COURRIEL=admin@jaden-konekte.fr
ADMIN_MOT_DE_PASSE=a-remplacer
DEMO_INITIALISER=true

# Assistant agronome : clé de l'API Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODELE=openai/gpt-oss-120b

# Réseau régional d'alertes : laisser RESEAU_CENTRAL_URL vide pour le désactiver.
# Essai local : COMPOSE_PROFILES=reseau et RESEAU_CENTRAL_URL=http://serveur-central:8080
COMPOSE_PROFILES=
RESEAU_CENTRAL_URL=
RESEAU_GROUPE=jaden-konekte
RESEAU_NOM=Jaden Konekté
RESEAU_URL_BASE=http://app:8000
RESEAU_SECRET=a-remplacer
