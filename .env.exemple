# Copier en .env puis remplacer chaque valeur  (PowerShell : .\scripts\initialiser-env.ps1)
# Le fichier .env est exclu de Git : il ne doit jamais être commité.

# --- PostgreSQL / TimescaleDB / pgvector
POSTGRES_USER=jaden
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=jaden

# --- Comptes MQTT (un par service, cf. infra/mosquitto/acl)
MQTT_INGESTION_MOT_DE_PASSE=a-remplacer
MQTT_API_MOT_DE_PASSE=a-remplacer
MQTT_REGLES_MOT_DE_PASSE=a-remplacer
MQTT_SIMULATEUR_MOT_DE_PASSE=a-remplacer
# MQTT_CAPTEUR_P1_MOT_DE_PASSE=a-remplacer   # ESP32 réel (facultatif)

# --- API
JWT_SECRET=a-remplacer-par-au-moins-32-caracteres-aleatoires
JWT_DUREE_S=3600
# Compte administrateur créé au premier démarrage s'il n'existe pas
ADMIN_COURRIEL=admin@jaden-konekte.fr
ADMIN_MOT_DE_PASSE=a-remplacer
# Crée l'exploitation « expl-1 » (p1, p2, p3) alimentée par le simulateur, rattachée à l'administrateur
DEMO_INITIALISER=true

LOG_NIVEAU=INFO
